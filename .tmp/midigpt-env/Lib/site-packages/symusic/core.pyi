    def dump_abc(self, path: str | os.PathLike, warn: bool = False) -> None:
        """
        Dump the score to an ABC file via midi2abc. Temporary MIDI files are cleaned up automatically.
        """

    def dumps_abc(self, warn: bool = False) -> str:
        """
        Return the score as an ABC notation string. Set *warn* to ``False`` to silence stderr.
        """

    def get_beats(self, start_time: float = 0.0) -> NDArray[numpy.float32]:
        """
        Return beat locations as a NumPy array in the score's current time unit. Compound meters follow the
        PrettyMIDI heuristic of grouping every three denominator notes into one beat.
        """

    def get_downbeats(self, start_time: float = 0.0) -> NDArray[numpy.float32]:
        """
        Return downbeat locations as a NumPy array in the score's current time unit. When no time
        signature is available at *start_time*, a 4/4 sentinel is assumed.
        """

    @property
    def ticks_per_quarter(self) -> int:
        """Ticks per quarter note"""

    @ticks_per_quarter.setter
    def ticks_per_quarter(self, arg: int, /) -> None: ...

    @property
    def tpq(self) -> int:
        """Alias of ticks_per_quarter"""

    @tpq.setter
    def tpq(self, arg: int, /) -> None: ...

    @property
    def tracks(self) -> TrackSecondList:
        """List of tracks"""

    @tracks.setter
    def tracks(self, arg: TrackSecondList, /) -> None: ...

    @property
    def time_signatures(self) -> TimeSignatureSecondList:
        """List of time signature events"""

    @time_signatures.setter
    def time_signatures(self, arg: TimeSignatureSecondList, /) -> None: ...

    @property
    def key_signatures(self) -> KeySignatureSecondList:
        """List of key signature events"""

    @key_signatures.setter
    def key_signatures(self, arg: KeySignatureSecondList, /) -> None: ...

    @property
    def tempos(self) -> TempoSecondList:
        """List of tempo events"""

    @tempos.setter
    def tempos(self, arg: TempoSecondList, /) -> None: ...

    @property
    def markers(self) -> TextMetaSecondList:
        """List of text/marker events"""

    @markers.setter
    def markers(self, arg: TextMetaSecondList, /) -> None: ...

    @property
    def ttype(self) -> Second:
        """Time unit type — Tick/Quarter/Second"""

    def __use_count(self) -> int:
        """
        Return the reference count of the shared score pointer for debugging aliasing.
        """

    def to(self, ttype: object, min_dur: object | None = None) -> object:
        """
        Convert the score to another time unit (Tick, Quarter, Second). ``ttype`` may be a class object or
        ``"tick"/"quarter"/"second"``. ``min_dur`` snaps durations when downsampling.
        """

    def resample(self, tpq: int, min_dur: float | None = None) -> ScoreTick:
        """
        Resample the score to a new ticks-per-quarter resolution. ``min_dur`` controls rounding behaviour
        when reducing resolution.
        """

    def sort(self, reverse: bool = False, inplace: bool = True) -> ScoreSecond:
        """
        Sort tracks chronologically. When *inplace* is False the operation occurs on a copy.
        """

    def clip(self, start: float, end: float, clip_end: bool = False, inplace: bool = False) -> ScoreSecond:
        """
        Clip the score to [start, end). When *inplace* is False returns a new score.
        """

    def shift_time(self, offset: float, inplace: bool = False) -> ScoreSecond:
        """
        Shift every event timestamp by *offset*. When *inplace* is False operate on a copy.
        """

    def shift_pitch(self, offset: int, inplace: bool = False) -> ScoreSecond:
        """
        Shift every note by *offset* semitones. When *inplace* is False operate on a copy.
        """

    def shift_velocity(self, offset: int, inplace: bool = False) -> ScoreSecond:
        """
        Shift every note velocity by *offset*. When *inplace* is False operate on a copy.
        """

    def start(self) -> float:
        """Return the earliest timestamp across all tracks."""

    def end(self) -> float:
        """Return the exclusive end timestamp across all tracks."""

    def note_num(self) -> int:
        """Return the total number of notes across all tracks."""

    def empty(self) -> bool:
        """Return True when the score contains no notes."""

    def adjust_time(self, original_times: Sequence[float], new_times: Sequence[float], inplace: bool = False) -> ScoreSecond:
        """
        Remap timestamps across all tracks using aligned original/new time arrays. Operates in place unless specified.
        """

class Synthesizer:
    """
    Synthesizer(sf_path: str | pathlib.Path, sample_rate: int = 44100, quality: int = 0)
    ============================================================================

    Prestosynth-powered renderer that turns scores into audio buffers using SF2/SF3 soundfonts. Reuse
    a single synthesizer per soundfont to avoid repeated disk I/O.

    Parameters
    ----------
    sf_path:
        Filesystem path to an SF2/SF3 soundfont (either ``str`` or ``pathlib.Path``).
    sample_rate:
        Output sample rate in Hz.
    quality:
        Prestosynth render quality hint (``0`` = default).

    Examples
    --------
    .. code-block:: python

        from symusic import Score, Synthesizer
        score = Score.from_file("example.mid")
        synth = Synthesizer("MuseScore_General.sf3", sample_rate=48000)
        buffer = synth.render(score, stereo=True)
        Synthesizer.dump_wav("example.wav", buffer, 48000, use_int16=True)
    """

    @overload
    def __init__(self, sf_path: str, sample_rate: int, quality: int) -> None:
        """Create a synthesizer from a string path to an SF2/SF3 soundfont."""

    @overload
    def __init__(self, sf_path: str | os.PathLike, sample_rate: int, quality: int) -> None:
        """
        Create a synthesizer from a ``pathlib.Path`` pointing to an SF2/SF3 soundfont.
        """

    @overload
    def render(self, score: ScoreTick, stereo: bool = True) -> "Eigen::Array<float,-1,-1,0,-1,-1>":
        """
        Render a :class:`symusic.Score` into a float32 waveform.

        Parameters
        ----------
        score:
            Tick/quarter/second score to render.
        stereo:
            When ``True`` two channels are emitted; otherwise mono.
        """

    @overload
    def render(self, score: ScoreQuarter, stereo: bool = True) -> "Eigen::Array<float,-1,-1,0,-1,-1>": ...

    @overload
    def render(self, score: ScoreSecond, stereo: bool = True) -> "Eigen::Array<float,-1,-1,0,-1,-1>": ...

def dump_wav(path: str, data: Annotated[NDArray[numpy.float32], dict(shape=(None, None), order='F', device='cpu')], sample_rate: int, use_int16: bool = True) -> None:
    """
    Write a :class:`numpy.ndarray` buffer to a WAV file using Prestosynth's writer.

    Parameters
    ----------
    path :
        Destination path.
    buffer :
        :class:`numpy.ndarray` with shape ``(samples,)`` or ``(channels, samples)``.
    sample_rate :
        Sample rate in Hz.
    use_int16 :
        Set to ``True`` to quantize the float32 buffer to PCM16.
    """
