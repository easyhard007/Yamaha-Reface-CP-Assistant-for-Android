<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    tools:context=".MainActivity">

    <!-- ============================================ -->
    <!-- 主界面 -->
    <!-- ============================================ -->
    <LinearLayout
        android:id="@+id/mainContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="visible">

        <TextView
            android:id="@+id/sample_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="reface_cp_assist Ready"
            android:textSize="18sp"
            android:textColor="#888888"
            android:gravity="center"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/tvChordInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="-- | -- | --"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#00E676"
            android:fontFamily="monospace"
            android:gravity="center"
            android:layout_marginBottom="16dp" />

        <!-- 钢琴键盘 -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/glass_panel"
            android:padding="4dp"
            android:layout_marginHorizontal="4dp">

            <HorizontalScrollView
                android:id="@+id/pianoScrollView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scrollbars="none"
                android:fillViewport="true"
                android:overScrollMode="never">

                <com.chenyinan.reface_cp_assist.PianoView
                    android:id="@+id/pianoView"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent" />
            </HorizontalScrollView>
        </FrameLayout>
    </LinearLayout>

    <!-- ============================================ -->
    <!-- 设置界面 -->
    <!-- ============================================ -->
    <ScrollView
        android:id="@+id/settingsContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 返回按钮 -->
            <Button
                android:id="@+id/btnBack"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="← 返回"
                android:textSize="16sp"
                android:layout_marginBottom="12dp" />

            <!-- 音源选择 -->
            <TextView
                android:id="@+id/tvSfLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Select SoundFont:"
                android:textColor="#CCCCCC" />

            <Spinner
                android:id="@+id/sfSpinner"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginBottom="12dp" />

            <!-- 乐器选择 -->
            <TextView
                android:id="@+id/tvInstLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Select Instrument:"
                android:textColor="#CCCCCC" />

            <Spinner
                android:id="@+id/instrumentSpinner"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginBottom="12dp" />

            <!-- 音量 -->
            <TextView
                android:id="@+id/tvVolumeLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Master Volume: 1.0"
                android:textColor="#CCCCCC" />

            <SeekBar
                android:id="@+id/volumeSeekBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100"
                android:progress="20"
                android:layout_marginBottom="12dp" />

            <!-- MIDI 设备 -->
            <TextView
                android:id="@+id/tvMidiLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MIDI Device:"
                android:textColor="#CCCCCC" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <Spinner
                    android:id="@+id/midiSpinner"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />

                <Button
                    android:id="@+id/btnRefreshMidi"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="Refresh" />
            </LinearLayout>

            <!-- MIDI 日志 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MIDI Monitor:"
                android:textColor="#CCCCCC" />

            <ScrollView
                android:id="@+id/midiLogScroll"
                android:layout_width="match_parent"
                android:layout_height="250dp"
                android:background="#1a1a1a"
                android:padding="8dp"
                android:layout_marginTop="4dp">

                <TextView
                    android:id="@+id/tvMidiLog"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="MIDI Log\n---"
                    android:textSize="11sp"
                    android:fontFamily="monospace"
                    android:textColor="#888888" />
            </ScrollView>

        </LinearLayout>
    </ScrollView>

    <!-- ============================================ -->
    <!-- FAB: 主界面左下角圆形按钮 -->
    <!-- ============================================ -->
    <Button
        android:id="@+id/fabSettings"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:text="?"
        android:textSize="24sp"
        android:textColor="#FFFFFF"
        android:background="@drawable/fab_circle"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_margin="24dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
