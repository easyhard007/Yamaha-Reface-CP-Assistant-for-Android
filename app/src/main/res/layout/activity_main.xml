<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    tools:context=".MainActivity">

    <!-- 1. 音色库选择 (新增) -->

    <!-- 2. 乐器选择 (原来的) -->

    <!-- 2. 乐器选择 (原来的) -->
    <Spinner
        android:id="@+id/sfSpinner"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:layout_marginTop="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvSfLabel" />

    <TextView
        android:id="@+id/tvSfLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Select SoundFont:"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvInstLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Select Instrument:"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@id/sfSpinner"
        app:layout_constraintStart_toStartOf="parent" />

    <Spinner
        android:id="@+id/instrumentSpinner"
        android:layout_width="0dp"
        android:layout_height="50dp"
        app:layout_constraintTop_toBottomOf="@id/tvInstLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvVolumeLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Master Volume: 1.0"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@+id/instrumentSpinner"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- 音量滑块 -->
    <SeekBar
        android:id="@+id/volumeSeekBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:max="100"
        android:progress="20"
        app:layout_constraintTop_toBottomOf="@+id/tvVolumeLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 状态文本 -->
    <TextView
        android:id="@+id/sample_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="CynArranger Ready"
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@id/volumeSeekBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="20dp"/>

    <!-- MIDI 设备选择 -->
    <TextView
        android:id="@+id/tvMidiLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="MIDI Device:"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/sample_text"
        app:layout_constraintStart_toStartOf="parent" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/tvMidiLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Spinner
            android:id="@+id/midiSpinner"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <Button
            android:id="@+id/btnRefreshMidi"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="Refresh" />
    </LinearLayout>

    <!-- 测试按钮 -->
    <Button
        android:id="@+id/btnTest"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="按住测试 (Test Note)"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvMidiLabel" />


</androidx.constraintlayout.widget.ConstraintLayout>